# 12 caractères minimum
APP_PASSWORD=
# 32 caractères minimum, par exemple : openssl rand -hex 32
SESSION_SECRET=
# Facultatif (production) : domaine personnalisé, déjà géré par Cloudflare. Sans domaine,
# l'instance est servie sur son adresse *.workers.dev.
RUNWAY_DOMAIN=
# Facultatif : analyse rédigée des insights
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# openai (par défaut) ou anthropic ; modèle par défaut selon le fournisseur
AI_PROVIDER=
AI_MODEL=
# Facultatif : catégorisation via Jev (TypeSafe AI)
TYPESAFE_API_KEY=
# Facultatif mais conseillé en production : clé « Demo » gratuite de CoinGecko, pour les cours crypto
COINGECKO_API_KEY=

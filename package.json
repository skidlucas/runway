{
  "name": "runway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:e2e",
    "db:generate": "drizzle-kit generate",
    "fixtures:actual": "node scripts/make-actual-fixture.mjs",
    "plan": "ALCHEMY_STATE=cloudflare alchemy plan --stage prod --env-file .env.prod",
    "deploy": "ALCHEMY_STATE=cloudflare alchemy deploy --stage prod --env-file .env.prod",
    "deploy:ci": "ALCHEMY_STATE=cloudflare alchemy deploy --stage prod --yes",
    "logs": "ALCHEMY_STATE=cloudflare alchemy logs --stage prod --env-file .env.prod --tail"
  },
